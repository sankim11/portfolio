# The "Ask about David" chat calls Claude through Vercel AI Gateway.
#
# Local development: copy this file to .env.local (ignored by git) and paste an
# AI Gateway API key. Create one in the Vercel dashboard under AI Gateway > API keys.
#
# Production on Vercel: leave this unset. Functions authenticate to the gateway
# automatically with the deployment's OIDC token, so no secret is stored.
AI_GATEWAY_API_KEY=

# Optional. Any gateway model ID works. The default is the low-cost Claude model.
# CHAT_MODEL=anthropic/claude-haiku-5.5
